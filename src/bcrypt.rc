#include <winver.h>
#include "version.h"

#ifndef WINE_LEGALCOPYRIGHT
#define WINE_LEGALCOPYRIGHT "Copyright (c) 1993-2025 the Wine project authors"
#endif

#ifndef WINE_PRODUCTNAME_STR
#define WINE_PRODUCTNAME_STR "Wine"
#endif

VS_VERSION_INFO VERSIONINFO
	FILEVERSION	WINE_FILEVERSION
	PRODUCTVERSION	WINE_PRODUCTVERSION
	FILEFLAGSMASK	63
#ifdef _DEBUG
	FILEFLAGS	1
#else
	FILEFLAGS	0
#endif
	FILEOS		VOS__WINDOWS32
	FILETYPE	VFT_DLL
	FILESUBTYPE	0 // not used
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904E4"
		//language ID = U.S. English, char set = Windows, Multilingual
		BEGIN
		VALUE "FileDescription",	WINE_FILEDESCRIPTION_STR "\0"
		VALUE "FileVersion",		WINE_FILEVERSION_STR "\0"
		VALUE "InternalName",		WINE_FILENAME_STR "\0"
		VALUE "LegalCopyright",		WINE_LEGALCOPYRIGHT ", 2025 A.Young " "\0"
		VALUE "OriginalFilename",	WINE_FILENAME_STR "\0"
		VALUE "ProductName",		WINE_PRODUCTNAME_STR "\0"
		VALUE "ProductVersion",		WINE_PRODUCTVERSION_STR "\0"
		VALUE "Comments",		"see: https://github.com/adamyg/bcrypt-XP" "\0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1252
	END
END

//end
